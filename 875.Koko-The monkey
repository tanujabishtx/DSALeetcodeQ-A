class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int low = 1;
        int high = 0;
        for (int banana : piles) {
            high = Math.max(high, banana);
        }
        int ans = 0;
        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (canEat(mid, piles, h)) {
                ans = mid;
                high = mid - 1;   
            } else {
                low = mid + 1;    
            }
        }
        return ans;
    }
    public boolean canEat(int mid, int[] piles, int h) {
        long total_time = 0;
        for (int i = 0; i < piles.length; i++) {
            total_time += (piles[i] + mid - 1) / mid;
        }

        return total_time <= h;
    }
}
